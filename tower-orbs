/* ================= battle ================= */
function startBattle(spec,fr){
  const info=stageInfo(spec),waves=genWaves(spec,info),team=buildTeam(fr);
  const lead=applyLeaders(team,[team[0],fr?team[team.length-1]:null]);
  const max=team.reduce((s,m)=>s+m.hp,0);
  B={spec,info,waves,wave:0,team,enemies:[],hp:max,max,target:0,phase:'idle',combos:[],guard:{pct:0,turns:0},drops:[],coins:0,over:false,fr,lead,turns:0,timeMax:6+lead.time};
  const el=$('#battle');el.hidden=false;
  el.innerHTML=`<div class="bt-top"><div class="nm">${AE[info.attr]} ${info.name}</div><div id="bt-wave"></div><div id="bt-dropn">🎁0</div><button class="btn sm ghost" data-act="giveup">放棄</button></div>
  <div class="bt-field a-${info.attr}" id="bt-field"><div id="bt-enemies"></div><div id="bt-banner"></div><div class="flashr" id="bt-flash"></div></div>
  <div id="bt-team"></div>
  <div class="hpbar" id="bt-hpbar"><i id="bt-hpfill"></i><span id="bt-hptxt"></span></div>
  <div class="timebar"><i id="bt-time"></i></div>
  <div id="bt-tip"></div>
  <div id="bt-boardwrap"><div id="board"></div><div id="bt-combo"></div></div>`;
  fitBoard();genBoard();rTeamB();updHP();spawnWave();tip();
}
function fitBoard(){
  if(!B)return;
  const bt=$('#battle'),W=bt.clientWidth||400,H=bt.clientHeight||700;
  cellS=Math.floor(Math.max(36,Math.min((W-8)/COLS,(H*.43)/ROWS)));
  const bd=$('#board');bd.style.setProperty('--cs',cellS+'px');bd.style.width=cellS*COLS+4+'px';bd.style.height=cellS*ROWS+4+'px';
  if(G)for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++)if(G[r][c])posOrb(G[r][c],r,c,false);
}
window.addEventListener('resize',()=>{if(B)fitBoard()});
const randOrb=()=>pick(ORBS);
function mkOrb(t){const el=document.createElement('div');el.className='orb a-'+t;el.innerHTML=`<i style="--ox:${ORBS.indexOf(t)}"></i>`;return{t,el}}
function setOrb(o,t){o.t=t;o.el.className='orb a-'+t;o.el.firstChild.style.setProperty('--ox',ORBS.indexOf(t))}
function posOrb(o,r,c,anim){o.el.style.transition=anim?'transform .2s ease-in':'none';o.el.style.transform=`translate(${c*cellS}px,${r*cellS}px)`}
function genBoard(){
  const bd=$('#board');bd.innerHTML='';G=[];
  for(let r=0;r<ROWS;r++){G[r]=[];for(let c=0;c<COLS;c++){
    let t;do{t=randOrb()}while((c>=2&&G[r][c-1].t===t&&G[r][c-2].t===t)||(r>=2&&G[r-1][c].t===t&&G[r-2][c].t===t));
    const o=mkOrb(t);G[r][c]=o;bd.appendChild(o.el);posOrb(o,r,c,false);
  }}
}
function tip(txt){const e=$('#bt-tip');if(e)e.textContent=txt||(B&&B.phase==='idle'?'按住珠子拖動轉珠・點敵人設為目標・點卡片使用技能':'')}
function rTeamB(){
  $('#bt-team').innerHTML=B.team.map((m,i)=>`<div class="tm mc a-${m.attr} r${m.rarity}" data-act="skill" data-i="${i}">${frameInner(m.d)}<div class="tl">${i===0?ico('crown'):m.friend?'友':''}</div>${m.as?`<div class="sk ${m.cdLeft?'':'ready'}">${m.cdLeft?m.cdLeft:'SKILL'}</div>`:''}</div>`).join('');
}
function updHP(){
  const p=100*B.hp/B.max,f=$('#bt-hpfill');
  f.style.width=p+'%';f.className=p<25?'low':p<55?'mid':'';
  $('#bt-hptxt').textContent=`${fmt(B.hp)} / ${fmt(B.max)}${B.guard.turns>0?`  🛡-${B.guard.pct}%`:''}`;
}
function mountEnemies(){
  const box=$('#bt-enemies');box.innerHTML='';
  B.enemies.forEach((e,i)=>{
    const el=document.createElement('div');el.className=`en a-${e.attr}${e.boss?' boss':''}`;el.dataset.act='target';el.dataset.i=i;
    el.innerHTML=`<div class="tg">🎯</div><span class="ab">${AN[e.attr]}</span><div class="cdn"></div><div class="face">${e.spr?sprHTML(e.spr.a,e.spr.r,e.spr.c):e.emo}</div><div class="hpb"><i></i></div><div class="nm2">${e.name}</div>`;
