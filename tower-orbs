}
function updEnemy(e){
  e.el.querySelector('.hpb i').style.width=(100*e.hp/e.max)+'%';
  e.el.querySelector('.cdn').textContent=e.hp>0?e.cd:'';
  e.el.classList.toggle('dead',e.hp<=0);
  e.el.classList.toggle('target',B.enemies[B.target]===e&&e.hp>0);
}
function refreshTargets(){B.enemies.forEach(updEnemy)}
function curTarget(){let e=B.enemies[B.target];if(!e||e.hp<=0){const i=B.enemies.findIndex(x=>x.hp>0);B.target=Math.max(0,i);e=B.enemies[B.target]}return e&&e.hp>0?e:null}
ACT.target=t=>{if(!B||B.over)return;B.target=+t.dataset.i;refreshTargets()};
function spawnWave(){
  B.enemies=B.waves[B.wave];B.enemies.forEach(e=>{e.cd=e.cdMax});B.target=0;mountEnemies();
  $('#bt-wave').textContent=`WAVE ${B.wave+1}/${B.waves.length}`;
  banner(B.wave===B.waves.length-1&&B.spec.kind==='tower'?'BOSS!':`WAVE ${B.wave+1}`);
}
function banner(t){const b=$('#bt-banner');b.textContent=t;b.classList.remove('on');void b.offsetWidth;b.classList.add('on')}
function popOn(el,txt,cls){
  const p=$('#battle'),pr=p.getBoundingClientRect(),er=el.getBoundingClientRect();
  const s=document.createElement('span');s.className='pop '+(cls||'');s.textContent=txt;
  s.style.left=(er.left-pr.left+er.width/2)+'px';s.style.top=(er.top-pr.top+er.height*.25)+'px';
  p.appendChild(s);setTimeout(()=>s.remove(),1000);
}
function shake(){const f=$('#bt-field');f.classList.remove('shake');void f.offsetWidth;f.classList.add('shake');const r=$('#bt-flash');r.classList.remove('on');void r.offsetWidth;r.classList.add('on')}
function showCombo(n){const c=$('#bt-combo');if(!c)return;if(!n){c.classList.remove('bump');return}c.textContent=`${n} COMBO`;c.classList.remove('bump');void c.offsetWidth;c.classList.add('bump');beep(300+n*50,.1,'square',.04)}

/* --- drag --- */
function cellAt(x,y){return{r:clamp(Math.floor(y/cellS),0,ROWS-1),c:clamp(Math.floor(x/cellS),0,COLS-1)}}
function bpos(e){const rc=$('#board').getBoundingClientRect();return{x:e.clientX-rc.left-2,y:e.clientY-rc.top-2}}
function moveHeld(p){const d=B.drag,x=clamp(p.x-cellS/2,0,cellS*(COLS-1)),y=clamp(p.y-cellS/2,0,cellS*(ROWS-1));d.o.el.style.transition='none';d.o.el.style.transform=`translate(${x}px,${y}px)`}
function releaseHeld(){const d=B.drag;if(!d)return;d.o.el.classList.remove('held');posOrb(d.o,d.r,d.c,true);B.drag=null}
document.addEventListener('pointerdown',e=>{
  if(!B||B.phase!=='idle'||!e.target.closest('#board'))return;
  e.preventDefault();
  const p=bpos(e),{r,c}=cellAt(p.x,p.y),o=G[r][c];
  B.drag={r,c,o};B.phase='hold';o.el.classList.add('held');
  try{$('#board').setPointerCapture(e.pointerId)}catch(_){}
  moveHeld(p);
});
document.addEventListener('pointermove',e=>{
  if(!B||!B.drag)return;
  const p=bpos(e),d=B.drag,t=cellAt(p.x,p.y);moveHeld(p);
  let g=0;
  while((d.r!==t.r||d.c!==t.c)&&g++<12){
    const dr=t.r-d.r,dc=t.c-d.c;let nr=d.r,nc=d.c;
    if(Math.abs(dc)>=Math.abs(dr))nc+=Math.sign(dc);else nr+=Math.sign(dr);
    const other=G[nr][nc];G[d.r][d.c]=other;G[nr][nc]=d.o;posOrb(other,d.r,d.c,true);d.r=nr;d.c=nc;
    beep(520,.03,'sine',.025);
    if(B.phase==='hold'){B.phase='drag';startTimer()}
  }
});
function endDrag(){
  if(!B||!B.drag)return;
  if(B.phase==='hold'){releaseHeld();B.phase='idle'}
  else if(B.phase==='drag')endMove();
}
document.addEventListener('pointerup',endDrag);
document.addEventListener('pointercancel',endDrag);
document.addEventListener('contextmenu',e=>{if(e.target.closest('#board'))e.preventDefault()});
function startTimer(){
  B.t0=performance.now();tip('');
  const bar=$('#bt-time'),total=B.timeMax*1000;
  const tick=()=>{
    if(!B||B.phase!=='drag')return;
    const left=total-(performance.now()-B.t0);
    bar.style.transform=`scaleX(${Math.max(0,left/total)})`;
    if(left<=0){endMove();return}
    B.raf=requestAnimationFrame(tick);
  };
  tick();
}
function endMove(){
  cancelAnimationFrame(B.raf);releaseHeld();
  B.phase='resolve';$('#bt-time').style.transform='scaleX(0)';
  turn();
}

/* --- match & resolve --- */
function findMatches(){
  const m=Array.from({length:ROWS},()=>Array(COLS).fill(false));
  for(let r=0;r<ROWS;r++){let c=0;while(c<COLS){const t=G[r][c].t;let e=c+1;while(e<COLS&&G[r][e].t===t)e++;if(e-c>=3)for(let k=c;k<e;k++)m[r][k]=true;c=e}}
  for(let c=0;c<COLS;c++){let r=0;while(r<ROWS){const t=G[r][c].t;let e=r+1;while(e<ROWS&&G[e][c].t===t)e++;if(e-r>=3)for(let k=r;k<e;k++)m[k][c]=true;r=e}}
  const seen=Array.from({length:ROWS},()=>Array(COLS).fill(false)),gs=[];
  for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){
    if(!m[r][c]||seen[r][c])continue;
    const t=G[r][c].t,st=[[r,c]],cells=[];seen[r][c]=true;
    while(st.length){
      const [y,x]=st.pop();cells.push([y,x]);
      [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dy,dx])=>{const ny=y+dy,nx=x+dx;if(ny>=0&&ny<ROWS&&nx>=0&&nx<COLS&&m[ny][nx]&&!seen[ny][nx]&&G[ny][nx].t===t){seen[ny][nx]=true;st.push([ny,nx])}});
    }
    const rows={};cells.forEach(([y])=>rows[y]=(rows[y]||0)+1);
    gs.push({t,cells,row:cells.length>=5||Object.values(rows).some(v=>v>=COLS)});
  }
  return gs;
}
function dropOrbs(){
  const bd=$('#board');
  for(let c=0;c<COLS;c++){
    let w=ROWS-1;
    for(let r=ROWS-1;r>=0;r--){if(G[r][c]){if(r!==w){G[w][c]=G[r][c];G[r][c]=null;posOrb(G[w][c],w,c,true)}w--}}
    let k=0;
    for(let r=w;r>=0;r--){
      k++;const o=mkOrb(randOrb());G[r][c]=o;bd.appendChild(o.el);posOrb(o,-k,c,false);void o.el.offsetWidth;posOrb(o,r,c,true);
    }
  }
}
async function resolveBoard(){
  let loops=0;
  while(loops++<30){
    const gs=findMatches();if(!gs.length)break;
    for(const g of gs){
      B.combos.push({t:g.t,n:g.cells.length,all:g.row});
      g.cells.forEach(([r,c])=>G[r][c].el.classList.add('clr'));
      showCombo(B.combos.length);await sleep(200);
      if(!B||B.over)return;
    }
    await sleep(150);
    gs.forEach(g=>g.cells.forEach(([r,c])=>{const o=G[r][c];if(o){o.el.remove();G[r][c]=null}}));
    dropOrbs();await sleep(420);
    if(!B||B.over)return;
  }
}

/* --- turn --- */
const om=n=>1+.25*(n-3);
async function turn(){
  const my=B;
  B.combos=[];showCombo(0);tip('');
  await resolveBoard();if(B!==my||B.over)return;
  B.turns++;
  await playerAttack();if(B!==my||B.over)return;
  B.team.forEach(m=>{if(m.cdLeft>0)m.cdLeft--});rTeamB();
  if(await checkClear())return;
  if(B!==my||B.over)return;
  await enemyPhase();
  if(B!==my||B.over||B.phase==='dead')return;
  B.phase='idle';$('#bt-time').style.transform='scaleX(1)';tip();
}
function healTeam(n){
  const before=B.hp;B.hp=Math.min(B.max,B.hp+n);updHP();
  popOn($('#bt-hpbar'),'+'+fmt(B.hp-before||n),'heal');
}
function hit(e,dmg,attr,cls){
  e.hp=Math.max(0,e.hp-dmg);popOn(e.el,fmt(dmg),(cls||'')+' a-'+attr);
  e.el.classList.add('hit');setTimeout(()=>e.el&&e.el.classList.remove('hit'),160);
  updEnemy(e);if(e.hp<=0)killEnemy(e);
}
function killEnemy(e){
  e.hp=0;e.el.classList.add('dead');
  B.drops.push(...e.drops);B.coins+=e.coin;
  $('#bt-dropn').textContent='🎁'+B.drops.length;
  beep(200,.2,'sawtooth',.04);
  const i=B.enemies.findIndex(x=>x.hp>0);if(i>=0&&B.enemies[B.target].hp<=0)B.target=i;
  refreshTargets();
}
async function playerAttack(){
  const N=B.combos.length;if(!N){await sleep(150);return}
  const cm=1+.25*(N-1),lb=B.lead.combos.filter(c=>N>=c.n).reduce((p,c)=>p*c.m,1);
  const heals=B.combos.filter(c=>c.t==='heart');
  if(heals.length){
    const rcv=B.team.reduce((s,m)=>s+m.rcv,0);let tot=0;heals.forEach(c=>tot+=rcv*om(c.n)*cm);
    healTeam(Math.round(tot));await sleep(350);
  }
  for(let i=0;i<B.team.length;i++){
    const m=B.team[i],my=B.combos.filter(c=>c.t===m.attr);if(!my.length)continue;
    if(!B.enemies.some(e=>e.hp>0))break;
    const tel=$$('#bt-team .tm')[i];if(tel){tel.classList.remove('atk');void tel.offsetWidth;tel.classList.add('atk')}
    const dealt=new Map();
    for(const c of my){
      const tg=c.all?B.enemies.filter(e=>e.hp>0):[curTarget()];
      for(const e of tg){
        if(!e||e.hp<=0)continue;
        const r=rel(m.attr,e.attr),d=Math.max(1,Math.round(m.atk*om(c.n)*cm*lb*r)-e.def);
        const o=dealt.get(e)||{d:0,r};o.d+=d;dealt.set(e,o);
      }
    }
    dealt.forEach((o,e)=>hit(e,o.d,m.attr,o.r>1?'crit':o.r<1?'resist':''));
    beep(260+i*40,.08,'square',.04);
    await sleep(300);
  }
  await sleep(150);
}
async function checkClear(){
  if(B.enemies.some(e=>e.hp>0))return false;
  await sleep(650);if(!B||B.over)return true;
  if(B.wave>=B.waves.length-1){win();return true}
  B.wave++;spawnWave();await sleep(800);
  B.phase='idle';$('#bt-time').style.transform='scaleX(1)';tip();return true;
}
async function enemyPhase(){
  B.enemies.forEach(e=>{if(e.hp>0){e.cd--;updEnemy(e)}});
  for(const e of B.enemies){
    if(e.hp<=0||e.cd>0)continue;
    e.el.classList.add('hit');await sleep(280);e.el.classList.remove('hit');
    let dmg=Math.max(1,Math.round(e.atk*(1-B.lead.red)*(1-B.guard.pct/100)*rnd(.95,1.05)));
    B.hp=Math.max(0,B.hp-dmg);updHP();shake();popOn($('#bt-hpbar'),'-'+fmt(dmg),'dmg');beep(110,.2,'sawtooth',.06);
    const tm=$$('#bt-team .tm');if(tm.length)popOn(pick(tm),'💥','');
    e.cd=e.cdMax;updEnemy(e);
    await sleep(420);
    if(B.hp<=0){lose();return}
  }
  if(B.guard.turns>0){B.guard.turns--;if(!B.guard.turns)B.guard.pct=0;updHP()}
}

/* --- active skills --- */
ACT.skill=t=>{
  if(!B||B.over)return;
  const i=+t.dataset.i,m=B.team[i],ready=m.as&&m.cdLeft===0&&B.phase==='idle';
  openModal(`<h3>${m.emo} ${m.name}</h3><div>${chip(m.attr)} <span class="stars">${stars(m.rarity)}</span> Lv${m.lv}　攻 ${fmt(m.atk)}　回 ${fmt(m.rcv)}</div>
  <div class="sec"><b>👑 隊長技</b><br>${lsText(m.ls)}</div>
  ${m.as?`<div class="sec"><b>✨ ${SKN[m.as.type]}</b> <small>（技能 Lv${m.sl}，冷卻 ${m.as.cd}，剩餘 ${m.cdLeft}）</small><br>${skText(m.as)}</div>`:`<div class="sec"><small>${m.friend?'好友卡片只提供隊長技':'此卡片沒有主動技'}</small></div>`}
  <div class="row"><button class="btn ghost" data-act="close">關閉</button>${ready?`<button class="btn gold" data-act="doSkill" data-i="${i}">發動技能</button>`:''}</div>`);
};
ACT.doSkill=async t=>{
  closeModal();
  if(!B||B.phase!=='idle')return;
  const i=+t.dataset.i,m=B.team[i],s=m.as;if(!s||m.cdLeft>0)return;
  B.phase='skill';banner(SKN[s.type]);beep(740,.2,'triangle');
  const my=B;
  switch(s.type){
    case 'convert':for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++){const o=G[r][c];if(s.from.includes(o.t)){setOrb(o,s.to);o.el.classList.add('flash');setTimeout(()=>o.el.classList.remove('flash'),420)}}break;
    case 'guard':B.guard={pct:s.pct,turns:s.turns};updHP();break;
    case 'heal':healTeam(Math.round(B.max*s.pct/100));break;
    case 'delay':B.enemies.forEach(e=>{if(e.hp>0){e.cd+=s.turns;updEnemy(e);popOn(e.el,`+${s.turns}`,'')}});break;
    case 'dmg':{const e=curTarget();if(e)hit(e,Math.max(1,Math.round(m.atk*s.m*rel(m.attr,e.attr))),m.attr,rel(m.attr,e.attr)>1?'crit':'');break}
    case 'dmgAll':B.enemies.filter(e=>e.hp>0).forEach(e=>hit(e,Math.max(1,Math.round(m.atk*s.m*rel(m.attr,e.attr))),m.attr,rel(m.attr,e.attr)>1?'crit':''));break;
  }
  m.cdLeft=s.cd;rTeamB();
  await sleep(500);
  if(B!==my||B.over)return;
  if(await checkClear())return;
  B.phase='idle';tip();
};
ACT.giveup=()=>{
  if(!B||B.over)return;
  if(B.phase!=='idle')return toast('請在轉珠前放棄');
  confirmBox('放棄本次挑戰？已消耗的體力不會退還，掉落物也會消失。',()=>{endBattle()},'放棄');
};

/* --- end of battle --- */
function lose(){
  B.phase='dead';
  openModal(`<h2 class="win" style="color:var(--bad);text-shadow:none">💀 全隊倒下了…</h2><div class="cfm" style="text-align:center">使用 ${ico('gem')}5 魔石復活，並回復全部生命繼續挑戰？<br><small style="color:var(--muted)">持有魔石：${S.gems}</small></div><div class="row"><button class="btn ghost" data-act="quit">放棄挑戰</button><button class="btn gold ${S.gems>=5?'':'dis'}" data-act="revive">復活 ${ico('gem')}5</button></div>`,'',true);
}
ACT.revive=()=>{if(S.gems<5)return toast('魔石不足');S.gems-=5;save();hud();B.hp=B.max;updHP();closeModal();B.phase='idle';$('#bt-time').style.transform='scaleX(1)';tip();toast('復活！')};
ACT.quit=()=>{closeAll();endBattle()};
function endBattle(){
  const el=$('#battle');el.hidden=true;el.innerHTML='';B=null;G=null;
  render(true);
}
function win(){
  B.over=true;B.phase='end';
  const info=B.info,spec=B.spec;
  const coins=info.coins+B.coins,lvB=S.lv,up=addExp(info.exp);
  S.coins+=coins;
  const fp=B.fr?10:0;S.fp+=fp;
  let gems=0;
  if(spec.kind==='tower'&&spec.f>S.floor){S.floor=spec.f;gems=info.first;S.gems+=gems}
  const got=[];let soldCoins=0;
  B.drops.forEach(id=>{
    if(bagFree()>0){const isNew=!S.seen[id];got.push({c:addCard(id),isNew})}
    else soldCoins+=30*CARD[id].rarity*CARD[id].rarity+10;
  });
  S.coins+=soldCoins;save();hud();beep(784,.4,'triangle');
  const nextOk=spec.kind==='tower';
  openModal(`<h2 class="win">🏆 戰鬥勝利！</h2>
  <div class="rw"><span>經驗值</span><b>+${fmt(info.exp)}${up?`　🎉 升級 Lv${lvB}→Lv${S.lv}（體力回滿）`:''}</b></div>
  <div class="rw"><span>金幣</span><b>${ico('coin')} +${fmt(coins+soldCoins)}</b></div>
  ${fp?`<div class="rw"><span>友情點</span><b>${ico('friend')} +${fp}</b></div>`:''}
  ${gems?`<div class="rw"><span>首次通關</span><b>${ico('gem')} +${gems}</b></div>`:''}
  <div style="margin:10px 0 4px;font-size:13px;font-weight:800">掉落卡片（${got.length}）</div>
  <div class="grid g5">${got.map(g=>miniD(CARD[g.c.id],{lv:1,nw:g.isNew})).join('')||'<div class="hint" style="grid-column:1/-1">本次沒有掉落卡片</div>'}</div>
  ${soldCoins?`<div class="hint" style="margin-top:6px">背包已滿，多出的卡片自動換成 ${ico('coin')}${fmt(soldCoins)}</div>`:''}
  <div class="row"><button class="btn ghost" data-act="resClose">返回</button><button class="btn" data-act="resAgain">再戰一次</button>${nextOk?`<button class="btn gold" data-act="resNext">下一層</button>`:''}</div>`,'wide',true);
}
ACT.resClose=()=>{closeAll();endBattle()};
ACT.resAgain=()=>{const s=B.spec;closeAll();endBattle();openStage(s)};
ACT.resNext=()=>{const s={kind:'tower',f:B.spec.f+1};closeAll();endBattle();UI.tab='tower';UI.sub='tower';render();openStage(s)};

/* ================= init ================= */
function init(){
  $('#nav').innerHTML=[['tower','🗼','爬塔'],['team','👥','隊伍'],['bag','🎒','背包'],['gacha','🎴','抽卡'],['dex','📖','圖鑑'],['more','⚙️','更多']].map(([v,i,n])=>`<button data-act="nav" data-v="${v}"><span>${i}</span>${n}</button>`).join('');
  render();
  if(!S.started)starterModal();else daily();
  setInterval(()=>{if(!B){tickStam();hud()}},1000);
}
init();
</script>
