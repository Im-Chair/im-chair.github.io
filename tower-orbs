/* ================= gacha ================= */
function rollGacha(kind){
  if(kind==='gem'){const r=wpick([3,4,5,6,7],k=>({3:45,4:34,5:16,6:4,7:1})[k]);return pick(POOL[r])}
  const r=wpick([1,2,3,4],k=>({1:45,2:33,3:18,4:4})[k]);
  return r===1?'sp_'+pick(ATTRS):pick(POOL[r]);
}
function doPull(kind,n){
  const cost=kind==='gem'?(n===1?5:50):(n===1?10:100);
  if((kind==='gem'?S.gems:S.fp)<cost)return toast(kind==='gem'?'魔石不足':'友情點不足');
  if(bagFree()<n)return toast(`背包空間不足（需要 ${n} 格）`);
  if(kind==='gem')S.gems-=cost;else S.fp-=cost;
  const res=[];for(let i=0;i<n;i++)res.push(rollGacha(kind));
  if(kind==='gem'&&n===10&&!res.some(id=>CARD[id].rarity>=5)){const r=wpick([5,6,7],k=>({5:80,6:16,7:4})[k]);res[9]=pick(POOL[r])}
  const out=res.map(id=>{const isNew=!S.seen[id];addCard(id);return{id,isNew}});
  S.pulls+=n;save();hud();
  const best=Math.max(...out.map(o=>CARD[o.id].rarity));
  beep(best>=6?880:best>=5?660:440,.25,'triangle');
  openModal(`<h3 style="text-align:center">${best>=5?'✨ 召喚成功 ✨':'召喚結果'}</h3><div class="grid ${n===1?'g3':'g5'}" style="${n===1?'padding:0 28%':''}">${out.map((o,i)=>{const d=CARD[o.id];return `<div class="gr ${d.rarity>=5?'hi':''}" style="animation-delay:${i*.1}s">${miniD(d,{lv:1,nw:o.isNew})}<div class="nmz">${d.name}</div></div>`}).join('')}</div>
  <div class="row"><button class="btn ghost" data-act="close">確定</button><button class="btn gold" data-act="pullAgain" data-k="${kind}" data-n="${n}">再抽一次</button></div>`,'wide');
  if(UI.tab==='gacha')render(true);
}

