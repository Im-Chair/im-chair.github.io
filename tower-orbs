  $('#h-exp').style.width=(100*S.exp/lvNeed(S.lv))+'%';
  $('#h-st').textContent=`${S.stam} / ${mx}`;
  $('#h-stt').textContent=S.stam>=mx?'（已滿）':`（+1 約 ${Math.max(0,Math.ceil((STAM_MS-(Date.now()-S.stamT))/1000))} 秒）`;
  $('#h-co').textContent=fmt(S.coins);$('#h-ge').textContent=fmt(S.gems);$('#h-fp').textContent=fmt(S.fp);
  $('#h-bag').textContent=`${S.cards.length}/${S.bagCap}`;
}

/* ================= stages ================= */
const SPS=[
  {k:'spirit',n:'元素精靈之巢',e:'🧚',d:'必掉元素精靈，強化與進化的好材料',cost:6,attr:'wood'},
  {k:'gold',n:'黃金洞窟',e:'💰',d:'大量金幣獎勵',cost:6,attr:'light'},
  {k:'exp',n:'經驗試煉場',e:'🧪',d:'高額玩家經驗值',cost:10,attr:'dark'}
];
const TIERS=[{n:'初級',f:8,u:2},{n:'中級',f:20,u:12},{n:'高級',f:35,u:25}];
function stageInfo(s){
  if(s.kind==='tower'){
    const f=s.f,a=ATTRS[(f-1)%5];
    return{f,name:`第 ${f} 層`,sub:`${ZONE[(f-1)%5]}迴廊${f%10===0?' · 魔王層':''}`,attr:a,cost:4+Math.floor(f/4),exp:40+f*12,coins:80+f*20,first:S.floor>=f?0:firstGems(f)};
  }
  const sp=SPS.find(x=>x.k===s.k),tr=TIERS[s.t-1],f=tr.f;
  return{f,name:`${sp.n}·${tr.n}`,sub:sp.d,attr:sp.attr,cost:sp.cost+(s.t-1)*2,exp:Math.round((40+f*12)*(s.k==='exp'?3:.5)),coins:Math.round((80+f*20)*(s.k==='gold'?5:.5)),first:0};
}
function mkEnemy(f,attr,boss,m={}){
  const li=ri(0,2),col=boss?ri(4,5):ri(0,3),cd0=CARD[attr+LETTER[li]+(col+2)];
  const hp=Math.round(650*Math.pow(f,1.32)*(boss?2.2:1)*rnd(.9,1.1)*(m.hp||1));
  const atk=Math.round(170*Math.pow(f,1.15)*(boss?1.35:1)*(m.atk||1));
  const def=Math.floor(Math.pow(f,1.6)*.8*(boss?1.5:1));
  const cd=boss?ri(3,4):ri(2,4);
  return{name:(boss?'魔化·':'')+cd0.name,emo:AE[attr],spr:cd0.spr,attr,boss,hp,max:hp,atk,def,cd,cdMax:cd,drops:[],coin:0};
}
function rollCard(f,boost){
  const w={2:Math.max(8,55-f),3:30+Math.min(f,20)*.5,4:10+f*.35,5:3+f*.18,6:f>=15?(f-14)*.06:0,7:f>=35?(f-34)*.02:0};
  if(boost){w[2]*=.3;w[5]*=1.5;w[6]*=1.5}
  const r=wpick([2,3,4,5,6,7],k=>w[k]);
  return pick(POOL[r]);
}
function rngSeed(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
/* 每層固定的掉落清單：只掉本層屬性的卡片，稀有度上限隨層數單調上升 */
function dropTable(s,info){
  if(s.kind!=='tower')return{normal:[],boss:[],spirits:s.k==='spirit'};
  const f=info.f,rng=rngSeed(f*7919+13),za=info.attr;
  const bMax=Math.min(7,3+Math.floor(f/10)),bMin=Math.max(2,bMax-2),nMax=Math.max(2,bMax-1),nMin=Math.max(2,nMax-1);
  const draw=(lo,hi,n)=>{
    const cand=CLIST.filter(d=>!d.spirit&&d.attr===za&&d.rarity>=lo&&d.rarity<=hi).map(d=>d.id);
    const top=cand.filter(id=>CARD[id].rarity===hi),out=[];
    if(top.length)out.push(top[Math.floor(rng()*top.length)]);
    cand.filter(id=>!out.includes(id)).map(id=>[rng(),id]).sort((x,y)=>x[0]-y[0]).forEach(([,id])=>{if(out.length<n)out.push(id)});
    return out.sort((x,y)=>CARD[x].rarity-CARD[y].rarity);
  };
  return{normal:draw(nMin,nMax,3),boss:draw(bMin,bMax,3),spirits:true};
}
function genWaves(s,info){
  const f=info.f,waves=[];
  if(s.kind==='tower'){
    const za=ATTRS[(f-1)%5],mix=()=>za,big=f%10===0,dt=dropTable(s,info);
    for(let w=0;w<3;w++){
      if(w<2)waves.push(Array.from({length:ri(2,3)},()=>mkEnemy(f,mix(),false)));
      else waves.push([mkEnemy(f,za,true,big?{hp:1.5,atk:1.2}:{})]);
    }
    waves.flat().forEach(e=>{
      e.coin=ri(20,40)+f*4;
      if(Math.random()<.4)e.drops.push('sp_'+e.attr);
      if(!e.boss&&Math.random()<.12)e.drops.push(pick(dt.normal));
      if(e.boss){e.drops.push(pick(dt.boss));if(Math.random()<.5)e.drops.push('sp_'+e.attr);if(Math.random()<.25)e.drops.push('cr_'+e.attr)}
    });
  }else{
    for(let w=0;w<3;w++)waves.push(Array.from({length:3},()=>{
      const a=pick(ATTRS),e=mkEnemy(f,a,false,{hp:.5,atk:.4});
      e.cd=e.cdMax=ri(3,4);
      if(s.k==='spirit'){e.name=AN[a]+'元素精靈';e.emo=AE[a];e.spr={a,r:0,c:0};e.drops=['sp_'+a];if(Math.random()<.2)e.drops.push('cr_'+a);if(Math.random()<.5)e.drops.push('sp_'+pick(ATTRS));e.coin=ri(10,20)}
      else if(s.k==='gold'){e.name='黃金哥布林';e.emo='🤑';e.spr=null;e.coin=ri(60,100)+f*10}
      else{e.name='經驗史萊姆';e.emo='🟢';e.spr=null;e.coin=ri(10,30)}
      return e;
    }));
  }
  return waves;
}

