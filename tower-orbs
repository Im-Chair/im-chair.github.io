<script>
'use strict';
/* ================= utils ================= */
const $=(s,r=document)=>r.querySelector(s), $$=(s,r=document)=>[...r.querySelectorAll(s)];
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const rnd=(a,b)=>a+Math.random()*(b-a), ri=(a,b)=>Math.floor(rnd(a,b+1)), pick=a=>a[Math.floor(Math.random()*a.length)];
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const fmt=n=>Math.round(n).toLocaleString('en-US');
function wpick(items,fn){let t=0;const w=items.map(i=>{const x=Math.max(0,fn(i));t+=x;return x});let r=Math.random()*t;for(let i=0;i<items.length;i++){r-=w[i];if(r<=0)return items[i]}return items[items.length-1]}

/* ================= data ================= */
const ATTRS=['water','fire','wood','light','dark'];
const AN={water:'水',fire:'火',wood:'木',light:'光',dark:'暗',heart:'心'};
const AE={water:'💧',fire:'🔥',wood:'🍃',light:'✨',dark:'🌙',heart:'❤️'};
const ORBS=[...ATTRS,'heart'];
const ZONE=['碧波','赤炎','翠林','聖光','幽暗'];
const COLS=6,ROWS=5;
const COSTS=[0,1,3,6,10,16,22,30];
const stars=r=>'★'.repeat(r);
const chip=a=>`<i class="abg in" style="--ai:${ATTRS.indexOf(a)}"></i>`;
function rel(a,d){
  if((a==='water'&&d==='fire')||(a==='fire'&&d==='wood')||(a==='wood'&&d==='water'))return 1.5;
  if((a==='fire'&&d==='water')||(a==='wood'&&d==='fire')||(a==='water'&&d==='wood'))return .5;
  if((a==='light'&&d==='dark')||(a==='dark'&&d==='light'))return 1.5;
  return 1;
}
const SKN={convert:'屬性轉換',guard:'守護結界',dmg:'必殺一擊',heal:'生命之泉',delay:'時間凍結',dmgAll:'毀滅風暴'};

const FAM={
 water:[
  {race:'妖精',n:['水滴史萊姆','迷你水母','碧波水母','珊瑚冠水母','深海水母王','星海水母女皇·莉維亞'],s:[1,1,1]},
  {race:'獸類',n:['小海龜','青甲龜','金紋海龜','珊瑚甲龜','蒼海守護龜','滄海巨甲·阿特拉斯'],s:[1.15,.85,1.1]},
  {race:'龍類',n:['小藍魚','彩鰭魚','飛鰭魚龍','白鱗海蛟','金角海龍','滄海龍帝·瀾'],s:[.95,1,1.2]}],
 fire:[
  {race:'龍類',n:['小火蜥','烈尾火蜥','炎角蜥龍','熔岩蜥將','炎獄龍','煉獄雙首龍·伊格'],s:[1,1,1]},
  {race:'神族',n:['火雛鳥','炎羽鳥','赤焰鷹','烈焰鳳雛','業火鳳凰','浴火神鳳·朱焰'],s:[.9,1.2,.9]},
  {race:'魔族',n:['熔岩球','熔岩石偶','熔岩岩怪','赤岩魔像','火山巨像','熔核巨神·伏爾甘'],s:[1.2,.95,.85]}],
 wood:[
  {race:'妖精',n:['嫩葉小狐','翠葉狐','青葉鹿狐','森之靈鹿','金角翠鹿','世界樹聖鹿·艾爾'],s:[1,1,1]},
  {race:'獸類',n:['葉雛','翠羽鳥','風葉鷹','綠翼獅鷲','翠翼獅鷲王','蒼風神鷲·賽芙'],s:[1,1,1.2]},
  {race:'獸類',n:['雲絨獸','葉雲犬','雲嵐狼','翠嵐狼','青雲狼王','嵐林天狼·菲洛'],s:[1.15,.9,1]}],
 light:[
  {race:'妖精',n:['光暈小兔','聖耳兔','星耳靈兔','聖光狐兔','金翼靈獸','聖輝天兔王·露米'],s:[1,1,1]},
  {race:'神族',n:['光雛鳥','聖光梟','金羽梟鷲','光翼獅鷲','曙光聖鷲','天耀神鷲·海里'],s:[1,.95,1.3]},
  {race:'獸類',n:['光鬃幼獅','星尾獅','聖鬃獅','白金獅將','翼獅聖獸','日冕聖獅王·阿斯'],s:[.95,1.15,1]}],
 dark:[
  {race:'魔族',n:['暗影小貓','紫焰影貓','暗角影獸','夜煉影狼','紫炎魔狼','冥焰龍狼王·諾克'],s:[1,1,1]},
  {race:'龍類',n:['暗影蝙蝠','紫焰飛蝠','夜翼蝠龍','暗翼飛龍','夜幕翼龍','暗淵魔龍·維爾'],s:[.95,1.15,1]},
  {race:'魔族',n:['骷髏小靈','幽冥骷髏','骨披幽靈獸','骸骨魔犬','死靈骨龍','冥界骸龍王·戈爾'],s:[1.15,.9,1]}]
};
/* 每條進化線的類型：[隊長技類型, 主動技類型] */
const LT={
  water:[['atk','convert'],['tank','guard'],['support','heal']],
  fire:[['atk','convert'],['combo','dmg'],['tank','dmgAll']],
  wood:[['atk','convert'],['heal','heal'],['tank','delay']],
  light:[['atk','convert'],['support','delay'],['dual','dmg']],
  dark:[['atk','convert'],['dual','dmgAll'],['tank','guard']]
};
const LETTER=['A','B','C'];
function baseStats(r,s){return{hp:Math.round(600*Math.pow(r,1.55)*s[0]),atk:Math.round(180*Math.pow(r,1.5)*s[1]),rcv:Math.round(80*Math.pow(r,1.4)*s[2])}}
function mkLS(a,li,r){
  const i=r-2,o={},set=(k,v)=>{if(v)o[k]=v},at=(m,attrs)=>{if(m>1)o.atkA={a:attrs||[a],m}};
  switch(LT[a][li][0]){
    case 'atk':at([1,1.5,2,2.5,3,3.5][i]);{const h=[1,1,1,1.2,1.4,1.6][i];if(h>1)o.hpA={a:[a],m:h}}set('time',[0,0,0,1,1,2][i]);break;
    case 'tank':set('hpAll',[1.1,1.2,1.3,1.4,1.5,1.7][i]);set('red',[0,.05,.1,.15,.2,.25][i]);at([1,1,1.3,1.6,2,2.5][i]);break;
    case 'combo':o.combo={n:[5,5,5,4,4,4][i],m:[1.3,1.6,1.8,2,2.5,3][i]};at([1,1,1.3,1.5,1.5,2][i]);break;
    case 'heal':at([1.2,1.4,1.6,2,2.5,3][i]);set('rcvAll',[1.1,1.3,1.5,1.8,2,2.5][i]);break;
    case 'support':set('hpAll',[1.1,1.15,1.2,1.3,1.4,1.5][i]);set('rcvAll',[1.2,1.3,1.5,1.8,2,2.5][i]);set('time',[0,0,1,1,2,2][i]);at([1,1,1,1.5,2,2][i]);break;
    case 'dual':at([1.2,1.5,1.8,2.2,2.6,3][i],['dark','light']);set('red',[0,0,0,.1,.15,.2][i]);set('time',[0,0,0,1,1,2][i]);break;
  }
  return Object.keys(o).length?o:null;
}
function mkAS(a,li,r){
  const i=r-2;
  switch(LT[a][li][1]){
    case 'convert':{const k=ATTRS.indexOf(a),order=[1,2,3,4].map(x=>ATTRS[(k+x)%5]),n=r<=3?1:r<=5?2:3,from=order.slice(0,n);if(r>=6)from.push('heart');return{type:'convert',from,to:a,cd:16-r}}
    case 'guard':return{type:'guard',pct:[20,30,40,50,50,60][i],turns:[1,1,1,2,2,2][i],cd:[13,13,12,12,11,10][i]};
    case 'dmg':return{type:'dmg',m:[3,4,5,6,7,8][i],cd:[10,10,10,9,9,8][i]};
    case 'heal':return{type:'heal',pct:[15,20,30,35,40,50][i],cd:[11,11,10,10,9,9][i]};
    case 'delay':return{type:'delay',turns:[1,1,2,2,3,3][i],cd:[10,11,11,12,12,12][i]};
    case 'dmgAll':return{type:'dmgAll',m:[2,2.5,3,4,5,6][i],cd:[10,10,10,9,9,8][i]};
  }
}
const CARD={},CLIST=[];
ATTRS.forEach(a=>FAM[a].forEach((f,li)=>f.n.forEach((nm,k)=>{
  const r=k+2,id=a+LETTER[li]+r;
  const d={id,name:nm,attr:a,race:f.race,rarity:r,emo:AE[a],spr:{a,r:li+1,c:k},...baseStats(r,f.s),cost:COSTS[r],ls:mkLS(a,li,r),as:mkAS(a,li,r),next:k<5?a+LETTER[li]+(r+1):null,fam:li};
  CARD[id]=d;CLIST.push(d);
})));
ATTRS.forEach(a=>{
  CARD['sp_'+a]={id:'sp_'+a,name:AN[a]+'之精靈',attr:a,race:'進化素材',rarity:1,emo:AE[a],spr:{a,r:0,c:0},...baseStats(1,[.2,.2,.2]),cost:1,ls:null,as:null,next:null,spirit:true};
  CARD['cr_'+a]={id:'cr_'+a,name:AN[a]+'之結晶',attr:a,race:'強化素材',rarity:2,emo:AE[a],spr:{a,r:0,c:1},...baseStats(1,[.2,.2,.2]),cost:1,ls:null,as:null,next:null,spirit:true,feed:600};
  CLIST.push(CARD['sp_'+a],CARD['cr_'+a]);
});
const IC={coin:0,gem:1,stam:2,friend:3,bag:4,lock:5,crown:6,flag:7,skill:8,up:9,sell:10,ribbon:11};
const ico=n=>`<i class="ico" style="--ii:${IC[n]}"></i>`;
const starI=r=>`<i class="star" style="--si:${r-1}"></i>`;
const frameInner=d=>`<div class="art">${art(d)}</div><i class="frm" style="--fr:${d.rarity-1}"></i>`;
const sprHTML=(a,r,c)=>`<i class="spr s-${a}" style="--cx:${c};--ry:${r}"></i>`;
const art=d=>sprHTML(d.spr.a,d.spr.r,d.spr.c);
const POOL={};for(let r=2;r<=7;r++)POOL[r]=CLIST.filter(d=>!d.spirit&&d.rarity===r).map(d=>d.id);

function lsText(o){
  if(!o)return '無';
  const p=[],an=x=>x.a.map(k=>AN[k]).join('、');
  if(o.atkA)p.push(`${an(o.atkA)}屬性攻擊力×${o.atkA.m}`);
  if(o.hpA)p.push(`${an(o.hpA)}屬性生命力×${o.hpA.m}`);
  if(o.hpAll)p.push(`全隊生命力×${o.hpAll}`);
  if(o.rcvAll)p.push(`全隊回復力×${o.rcvAll}`);
  if(o.combo)p.push(`${o.combo.n}連擊以上時，全隊攻擊力×${o.combo.m}`);
  if(o.red)p.push(`受到傷害減少${Math.round(o.red*100)}%`);
  if(o.time)p.push(`轉珠時間+${o.time}秒`);
  return p.join('；');
}
function skText(s){
  if(!s)return '無';
  switch(s.type){
    case 'convert':return `將${s.from.map(k=>AN[k]).join('、')}珠轉化為${AN[s.to]}珠`;
    case 'guard':return `${s.turns}回合內，受到的傷害減少${s.pct}%`;
    case 'dmg':return `對目標敵人造成自身攻擊力×${s.m}的傷害（無視防禦）`;
    case 'heal':return `回復隊伍最大生命力的${s.pct}%`;
    case 'delay':return `使所有敵人的行動延遲${s.turns}回合`;
    case 'dmgAll':return `對全體敵人造成自身攻擊力×${s.m}的傷害（無視防禦）`;
  }
}

/* ================= state ================= */
const KEY='tower_orbs_save_v1';
function fresh(){return{started:false,lv:1,exp:0,stam:30,stamT:Date.now(),coins:1000,gems:50,fp:50,bagCap:80,cards:[],uid:1,teams:[[],[],[]],at:0,floor:0,login:'',pulls:0,seen:{},snd:true}}
let S;
try{S=Object.assign(fresh(),JSON.parse(localStorage.getItem(KEY)||'null')||{})}catch(e){S=fresh()}
S.teams=(S.teams||[[],[],[]]).map(t=>{const a=(t||[]).slice(0,5);while(a.length<5)a.push(null);return a});
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
const UI={tab:'tower',sub:'tower',bag:{sort:'rar',attr:'all',multi:false,sel:new Set()},fr:null,feed:null,pick:null};
let B=null,G=null,cellS=56,CB=null;

/* ================= card helpers ================= */
const byUid=u=>S.cards.find(c=>c.uid===u);
const maxLv=r=>[0,10,20,30,40,50,60,70][r];
const expAt=(r,lv)=>Math.floor(2*r*Math.pow(lv-1,1.7));
function lvOfExp(r,exp){const m=maxLv(r);let lv=1;while(lv<m&&exp>=expAt(r,lv+1))lv++;return lv}
const lvOf=c=>lvOfExp(CARD[c.id].rarity,c.exp);
function statsAt(d,lv){const m=maxLv(d.rarity),t=m>1?Math.pow((lv-1)/(m-1),1.1):1,f=.35+.65*t;return{hp:Math.round(d.hp*f),atk:Math.round(d.atk*f),rcv:Math.round(d.rcv*f)}}
const cstats=c=>{const lv=lvOf(c);return{lv,...statsAt(CARD[c.id],lv)}};
const FEED=[0,150,450,1100,2400,4800,8500,14000];
function feedExp(c,t){const d=CARD[c.id];let x=(d.feed||FEED[d.rarity])*(1+(lvOf(c)-1)*.1);if(t&&CARD[t.id].attr===d.attr)x*=1.5;return Math.round(x)}
const sellVal=c=>{const d=CARD[c.id];return Math.round(30*d.rarity*d.rarity+lvOf(c)*10)};
const usedSet=()=>new Set(S.teams.flat().filter(Boolean));
const teamCost=t=>t.reduce((s,u)=>{const c=u&&byUid(u);return s+(c?CARD[c.id].cost:0)},0);
const costCap=()=>30+2*S.lv;
const bagFree=()=>S.bagCap-S.cards.length;
function addCard(id){const c={uid:S.uid++,id,exp:0,lock:false,nw:true};S.cards.push(c);S.seen[id]=1;return c}
function removeCards(set){S.cards=S.cards.filter(c=>!set.has(c.uid))}
const SKMAX=5;
const effCd=(as,sl)=>Math.max(3,as.cd-((sl||1)-1));
const skKey=d=>d.as?JSON.stringify({...d.as,cd:0}):null;
const lvNeed=lv=>40+lv*15;
const firstGems=f=>f%10===0?10:f%5===0?5:2;
const stamMax=()=>25+Math.min(S.lv,150);
const STAM_MS=20000;
function addExp(n){let up=0;S.exp+=n;while(S.exp>=lvNeed(S.lv)){S.exp-=lvNeed(S.lv);S.lv++;up++}if(up){S.stam=Math.max(S.stam,stamMax());S.stamT=Date.now()}return up}
function tickStam(){const mx=stamMax(),now=Date.now();if(S.stam>=mx){S.stamT=now;return}const g=Math.floor((now-S.stamT)/STAM_MS);if(g>0){S.stam=Math.min(mx,S.stam+g);S.stamT+=g*STAM_MS;if(S.stam>=mx)S.stamT=now}}

function miniD(d,o={}){
  const ai=ATTRS.indexOf(d.attr);
  return `<div class="mc a-${d.attr} r${d.rarity}${o.sel?' sel':''}${o.ghost?' ghost':''}" ${o.act?`data-act="${o.act}" ${o.u!=null?`data-u="${o.u}"`:''} ${o.id?`data-id="${o.id}"`:''}`:''}>${o.ghost?'<div class="art">？</div><i class="frm" style="--fr:0"></i>':`${frameInner(d)}<i class="abg" style="--ai:${ai}"></i>${o.lv&&!d.spirit?`<span class="lvz">Lv${o.lv}</span>`:''}<div class="stz">${starI(d.rarity)}${d.rarity}</div>${o.lock?'<i class="lk"></i>':''}${o.nw?'<i class="nw">NEW</i>':''}${o.team?'<i class="tmk">隊</i>':''}${o.sk?'<i class="sk2">技</i>':''}${o.fx?`<i class="fx">+${fmt(o.fx)}</i>`:''}${o.sel?'<i class="ck">✔</i>':''}`}</div>`;
}
function mini(c,o={}){return miniD(CARD[c.id],{lv:lvOf(c),lock:c.lock,nw:c.nw,team:!o.noTeam&&usedSet().has(c.uid),act:o.act,u:c.uid,sel:o.sel,fx:o.fx,sk:o.sk})}

/* ================= sound ================= */
let AC=null;
function beep(f,d=.09,t='sine',v=.07){
  if(!S.snd)return;
  try{
    AC=AC||new (window.AudioContext||window.webkitAudioContext)();
    const o=AC.createOscillator(),g=AC.createGain();o.type=t;o.frequency.value=f;g.gain.value=v;
    g.gain.exponentialRampToValueAtTime(.0001,AC.currentTime+d);o.connect(g);g.connect(AC.destination);o.start();o.stop(AC.currentTime+d);
  }catch(e){}
}

/* ================= modal / toast / hud ================= */
const MR=()=>$('#modal-root');
function openModal(html,cls='',lock=false){const m=document.createElement('div');m.className='mask';if(lock)m.dataset.lock='1';m.innerHTML=`<div class="modal ${cls}">${html}</div>`;m.addEventListener('click',e=>{if(e.target===m&&!m.dataset.lock)closeModal()});MR().appendChild(m);return m.firstChild}
function setModal(html){const m=MR().lastElementChild;if(!m)return;const sc=$('.scroll',m),st=sc?sc.scrollTop:0;m.firstChild.innerHTML=html;const n=$('.scroll',m);if(n)n.scrollTop=st}
function closeModal(){const m=MR().lastElementChild;if(m)m.remove()}
function closeAll(){MR().innerHTML=''}
function confirmBox(msg,yes,label='確定'){CB=yes;openModal(`<div class="cfm">${msg}</div><div class="row"><button class="btn ghost" data-act="close">取消</button><button class="btn gold" data-act="cbyes">${label}</button></div>`)}
let toastT;
