<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>轉珠之塔 · 神魔之塔致敬版</title>
<style>
:root{
  --bg:#070b1a;--bg2:#0e1431;--panel:#141b3b;--panel2:#1d2650;--line:#2e3a78;--text:#eef0ff;--muted:#8d97cf;--gold:#ffd36b;--gold2:#ff9f3a;--ok:#4fe08a;--bad:#ff5a6a;
  --water:#3b9cff;--water-d:#0d3f96;--fire:#ff5a40;--fire-d:#9c160c;--wood:#43cc60;--wood-d:#106a26;--light:#ffd84d;--light-d:#9a6c08;--dark:#a566e6;--dark-d:#431a82;--heart:#ff77b0;--heart-d:#9c2058;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:inherit}
html,body{height:100%;margin:0;background:var(--bg);color:var(--text);font-family:"PingFang TC","Noto Sans TC","Microsoft JhengHei","Heiti TC",system-ui,-apple-system,sans-serif;-webkit-tap-highlight-color:transparent;overscroll-behavior:none;user-select:none;-webkit-user-select:none}
button{font-family:inherit}
b{font-weight:800}
#app{position:relative;height:100%;max-width:480px;margin:0 auto;display:flex;flex-direction:column;overflow:hidden;background:radial-gradient(120% 55% at 50% 0,#1b2556 0,var(--bg) 62%);border-inline:1px solid #1a224d}
.a-water{--c:var(--water);--cd:var(--water-d)}.a-fire{--c:var(--fire);--cd:var(--fire-d)}.a-wood{--c:var(--wood);--cd:var(--wood-d)}.a-light{--c:var(--light);--cd:var(--light-d)}.a-dark{--c:var(--dark);--cd:var(--dark-d)}.a-heart{--c:var(--heart);--cd:var(--heart-d)}
.r1{--rc:#8b93b8}.r2{--rc:#5ec27a}.r3{--rc:#4aa3ff}.r4{--rc:#b56cff}.r5{--rc:#ffcf4a}.r6{--rc:#ff7ac8}.r7{--rc:#ffffff}

/* HUD */
#hud{padding:8px 10px 7px;background:linear-gradient(#18204a,#0f1534);border-bottom:1px solid var(--line);flex:none}
.hud1{display:flex;align-items:center;gap:10px}
.lvb{min-width:52px;text-align:center;font-size:11px;color:var(--gold);line-height:1}
.lvb b{display:block;font-size:22px;color:#fff;margin-top:2px}
.grow{flex:1;min-width:0}
.expbar{height:6px;border-radius:3px;background:#0007;overflow:hidden}
.expbar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#ffd36b,#ff9f3a)}
.stam{font-size:12px;margin-top:4px;color:var(--muted)}
.stam b{color:#fff}
.res{display:flex;gap:6px;margin-top:6px;font-size:12px;flex-wrap:wrap}
.res span{background:#0006;border:1px solid var(--line);border-radius:12px;padding:2px 9px}
#screen{flex:1;overflow-y:auto;padding:10px 10px 16px;-webkit-overflow-scrolling:touch}
#nav{flex:none;display:grid;grid-template-columns:repeat(6,1fr);background:#0b1030;border-top:1px solid var(--line)}
#nav button{background:none;border:0;color:var(--muted);padding:7px 0 6px;font-size:11px;cursor:pointer}
#nav button span{display:block;font-size:20px;line-height:1.2}
#nav button.on{color:var(--gold);background:linear-gradient(#0000,#ffd36b18)}

/* Buttons & generic */
.btn{background:linear-gradient(#5566ff,#2f3bd0);color:#fff;border:0;border-radius:10px;padding:10px 14px;font-weight:800;font-size:14px;cursor:pointer;box-shadow:0 2px 0 #0007}
.btn.gold{background:linear-gradient(#ffdc7d,#ff9f3a);color:#3b2200}
.btn.ghost{background:#252f63;color:#dfe3ff}
.btn.red{background:linear-gradient(#ff6a7a,#c52a45)}
.btn.sm{padding:5px 10px;font-size:12px}
.btn.full{width:100%}
.btn:disabled,.btn.dis{opacity:.4;pointer-events:none}
.btn:active{transform:translateY(1px)}
.row{display:flex;gap:8px;margin-top:10px}
.row>*{flex:1}
.row.wrap{flex-wrap:wrap}
.tabs{display:flex;gap:6px;margin-bottom:10px}
.tabs button{flex:1;background:#1a2250;border:1px solid var(--line);color:var(--muted);border-radius:10px;padding:9px 0;font-weight:700;font-size:13px;cursor:pointer}
.tabs button.on{background:linear-gradient(#34419a,#232c70);color:#fff;border-color:#7a8bff}
.hint{font-size:12px;color:var(--muted);margin:2px 2px 10px;line-height:1.55}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:12px;margin-bottom:10px}
.panel h3{margin:0 0 6px;font-size:16px}
.chip{display:inline-grid;place-items:center;min-width:20px;height:20px;border-radius:10px;padding:0 5px;font-size:12px;font-weight:800;color:#fff;background:var(--c);text-shadow:0 1px 1px #0008;border:1px solid #fff6;vertical-align:middle}
.grid{display:grid;gap:6px}
.g5{grid-template-columns:repeat(5,1fr)}.g4{grid-template-columns:repeat(4,1fr)}.g3{grid-template-columns:repeat(3,1fr)}
.scroll{max-height:46vh;overflow-y:auto;padding:2px}
.sec{background:#0c1130;border:1px solid var(--line);border-radius:10px;padding:8px 10px;margin-top:8px;font-size:13px;line-height:1.55}
.sec small{color:var(--muted)}

/* Tower list */
.floor{display:flex;align-items:center;gap:10px;padding:9px 10px;margin-bottom:7px;border-radius:12px;border:1px solid var(--line);background:linear-gradient(90deg,color-mix(in srgb,var(--c) 28%,#10163a),#10163a 70%);cursor:pointer}
.floor .fn{width:46px;height:46px;border-radius:10px;display:grid;place-items:center;font-weight:900;font-size:19px;background:radial-gradient(circle at 50% 30%,var(--c),var(--cd));text-shadow:0 2px 3px #0009;flex:none}
.floor .fi{flex:1;min-width:0}
.floor .fi b{font-size:15px}
.floor .fi div{font-size:12px;color:var(--muted);margin-top:2px}
.floor .fc{font-size:13px;color:var(--gold);text-align:right;flex:none}
.floor.lock{opacity:.35;pointer-events:none;filter:grayscale(.8)}
.floor.cur{border-color:var(--gold);box-shadow:0 0 14px #ffd36b55}
.floor.done .fn::after{content:"✔";position:absolute;right:-4px;bottom:-4px;font-size:10px;color:#052;background:var(--ok);border-radius:50%;width:16px;height:16px;line-height:16px;text-align:center;text-shadow:none}
.floor .fn{position:relative}

/* Cards */
.mc{position:relative;aspect-ratio:192/212;cursor:pointer;min-width:0}
.mc.sel{outline:2px solid var(--ok)}
.mc.ghost{filter:grayscale(1) brightness(.4)}
.mc.ghost .art{font-size:22px;color:#9aa}
.dt-top{display:flex;gap:12px;align-items:flex-start}
.dt-info{flex:1;min-width:0;font-size:13px;line-height:1.6}
.dt-info .nm{font-size:18px;font-weight:900}
.stars{color:#ffe27a;letter-spacing:-1px;font-size:13px}
.statline{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:8px;text-align:center;font-size:12px}
.statline div{background:#0c1130;border:1px solid var(--line);border-radius:8px;padding:5px 2px}
.statline b{display:block;font-size:15px}
.xpbar{height:6px;background:#0008;border-radius:3px;overflow:hidden;margin-top:6px}
.xpbar i{display:block;height:100%;background:linear-gradient(90deg,#4fe08a,#2fb0ff)}
.slots{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-bottom:8px}
.slot{text-align:center;font-size:10px;color:var(--muted)}
.slot .empty{aspect-ratio:192/212;border:2px dashed var(--line);border-radius:10px;display:grid;place-items:center;font-size:22px;color:var(--muted);background:#0c1130}
.slot .sl{margin-top:2px}

/* Modal */
.mask{position:absolute;inset:0;background:#000b;z-index:60;display:flex;align-items:center;justify-content:center;padding:12px;animation:fade .15s}
.modal{background:linear-gradient(#18204a,#111737);border:1px solid #4150a8;border-radius:16px;width:100%;max-height:94%;overflow-y:auto;padding:14px;box-shadow:0 10px 40px #000a}
.modal h2,.modal h3{margin:0 0 8px}
.modal .cfm{font-size:15px;line-height:1.6;padding:6px 2px}
.modal.wide{padding:12px 10px}
.win{color:var(--gold);text-align:center;font-size:24px;margin:2px 0 8px!important;text-shadow:0 0 14px #ffb83a}
.rw{display:flex;justify-content:space-between;padding:6px 10px;background:#0c1130;border-radius:8px;margin-top:6px;font-size:14px}
.fr{display:flex;gap:8px;align-items:center;padding:6px;border:1px solid var(--line);border-radius:10px;margin-top:6px;background:#0d1233;cursor:pointer}
.fr.on{border-color:var(--gold);background:#2a2a1a}
.fr .mc{width:50px;flex:none}
.fr .ft{flex:1;font-size:12px;line-height:1.45;min-width:0}
.gr{text-align:center;font-size:10px;animation:flipin .5s both}
.gr .nmz{margin-top:2px;line-height:1.2}
.gr.hi .mc{animation:glow 1.2s infinite alternate}
#toast{position:absolute;left:50%;top:14%;transform:translateX(-50%);z-index:99;background:#000d;border:1px solid #5d6bd1;padding:8px 16px;border-radius:20px;font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s;max-width:86%;text-align:center}
#toast.on{opacity:1}
.rates{font-size:12px;color:var(--muted);line-height:1.7;margin-bottom:8px}

/* Battle */
#battle{position:absolute;inset:0;z-index:30;background:#060916;display:flex;flex-direction:column}
#battle[hidden]{display:none}
.bt-top{flex:none;display:flex;align-items:center;gap:8px;padding:6px 10px;font-size:13px;background:#0b1030;border-bottom:1px solid var(--line)}
.bt-top .nm{flex:1;font-weight:800;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.bt-field{position:relative;flex:1;min-height:100px;overflow:hidden;background:radial-gradient(90% 90% at 50% 100%,color-mix(in srgb,var(--c) 38%,#0b0f2c),#070a1c 80%)}
.bt-field::before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(100deg,#ffffff06 0 2px,#0000 2px 26px)}
.bt-field.shake{animation:shake .35s}
#bt-enemies{position:absolute;inset:0 0 6px;display:flex;align-items:flex-end;justify-content:center;gap:8px;padding:0 8px}
.en{position:relative;width:84px;text-align:center;cursor:pointer;transition:opacity .5s,transform .5s;padding-top:18px}
.en.boss{width:148px}
.en .face{font-size:56px;line-height:1.05;filter:drop-shadow(0 8px 8px #000b);transition:transform .15s}
.en.boss .face{font-size:100px}
.en.hit .face{transform:scale(1.35) translateY(14px)}
.en.dead{opacity:0;transform:scale(.5) translateY(20px);pointer-events:none}
.en .hpb{height:8px;border-radius:4px;background:#000a;overflow:hidden;border:1px solid #fff4;margin:2px 4px 0}
.en .hpb i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#ff4a5e,#ff9d5a);transition:width .35s}
.en .nm2{font-size:10px;margin-top:2px;text-shadow:0 1px 2px #000}
.en .cdn{position:absolute;top:12px;right:6px;min-width:20px;height:20px;border-radius:10px;background:#000c;border:1px solid #fff7;font-size:12px;line-height:18px;font-weight:800}
.en .ab{position:absolute;top:12px;left:6px;width:20px;height:20px;border-radius:50%;background:var(--c);border:1px solid #fffa;font-size:11px;line-height:18px;font-weight:800;text-shadow:0 1px 1px #000a}
.en .tg{position:absolute;top:0;left:50%;transform:translateX(-50%);font-size:14px;display:none;animation:bob .8s infinite alternate}
.en.target .tg{display:block}
#bt-banner{position:absolute;left:0;right:0;top:34%;text-align:center;font-size:30px;font-weight:900;letter-spacing:3px;color:#fff;text-shadow:0 0 16px var(--gold),0 3px 0 #000;opacity:0;pointer-events:none}
#bt-banner.on{animation:banner 1.4s}
.pop{position:absolute;z-index:6;font-weight:900;font-size:22px;color:#fff;pointer-events:none;text-shadow:0 2px 0 #000,0 0 6px var(--c,#fff);animation:floatup .95s ease-out forwards;white-space:nowrap}
.pop.crit{font-size:28px;color:#fff3a0}
.pop.resist{font-size:16px;color:#bbb}
.pop.heal{color:#8dffb4;--c:#2f9}
.pop.dmg{color:#ff7d8a;--c:#f23}
#bt-team{flex:none;display:grid;grid-template-columns:repeat(6,1fr);gap:4px;padding:6px 6px 2px;background:#0a0e28}
.tm{position:relative;aspect-ratio:192/212;cursor:pointer}
.tm .tl{position:absolute;left:1px;top:-6px;font-size:11px;font-weight:800;text-shadow:0 1px 2px #000}
.tm .sk{position:absolute;left:0;right:0;bottom:0;text-align:center;font-size:9px;font-weight:900;background:#000b;border-radius:0 0 6px 6px}
.tm .sk.ready{background:linear-gradient(#ffdc7d,#ff9f3a);color:#3b2200;animation:pulse 1s infinite alternate}
.tm.atk{animation:atkup .3s}
.hpbar{position:relative;flex:none;height:20px;margin:4px 8px 0;border-radius:10px;background:#000a;border:1px solid #fff4;overflow:hidden}
.hpbar i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#27d17a,#8bf06a);transition:width .3s}
.hpbar i.mid{background:linear-gradient(90deg,#f1c232,#ffd966)}
.hpbar i.low{background:linear-gradient(90deg,#e8384f,#ff7a5a)}
.hpbar span{position:absolute;inset:0;display:grid;place-items:center;font-size:12px;font-weight:800;text-shadow:0 1px 2px #000}
.timebar{flex:none;height:8px;margin:5px 8px 0;border-radius:4px;background:#000a;overflow:hidden}
.timebar i{display:block;height:100%;width:100%;background:linear-gradient(90deg,#3b9cff,#6ff);transform-origin:left}
#bt-tip{flex:none;text-align:center;font-size:11px;color:var(--muted);height:16px;line-height:16px;margin-top:2px}
#bt-boardwrap{position:relative;flex:none;display:flex;justify-content:center;padding:0 0 6px}
#board{position:relative;touch-action:none;overflow:hidden;border-radius:8px;border:2px solid #2b3678;background:conic-gradient(#0e1330 25%,#151c43 0 50%,#0e1330 0 75%,#151c43 0) 0 0/calc(var(--cs)*2) calc(var(--cs)*2)}
#bt-combo{position:absolute;left:0;right:0;top:36%;text-align:center;font-size:36px;font-weight:900;color:#ffe27a;text-shadow:0 3px 0 #a3321e,0 0 18px #ff9f3a;pointer-events:none;opacity:0}
#bt-combo.bump{opacity:1;animation:bump .22s}
.orb{position:absolute;left:0;top:0;width:var(--cs);height:var(--cs);display:grid;place-items:center;will-change:transform}
.orb i{font-style:normal;width:86%;height:86%;border-radius:50%;display:grid;place-items:center;font-size:calc(var(--cs)*.45);line-height:1;background:radial-gradient(circle at 34% 28%,rgba(255,255,255,.8) 0,rgba(255,255,255,0) 32%),radial-gradient(circle at 50% 55%,var(--c) 0,var(--cd) 100%);box-shadow:inset 0 -3px 7px rgba(0,0,0,.45),0 2px 5px rgba(0,0,0,.6);transition:transform .12s}
.orb.held{z-index:9}
.orb.held i{transform:scale(1.2);filter:brightness(1.25) drop-shadow(0 6px 8px #000a)}
.orb.clr i{animation:orbpop .32s forwards}
.orb.flash i{animation:flasho .4s}
.flashr{position:absolute;inset:0;background:radial-gradient(circle,#0000 40%,#ff203088);pointer-events:none;opacity:0;z-index:5}
.flashr.on{animation:redf .4s}

@keyframes fade{from{opacity:0}}
@keyframes rb{to{background-position:300% 0}}
@keyframes floatup{0%{opacity:0;transform:translate(-50%,10px) scale(.6)}15%{opacity:1;transform:translate(-50%,-4px) scale(1.2)}100%{opacity:0;transform:translate(-50%,-56px) scale(1)}}
@keyframes orbpop{0%{transform:scale(1);opacity:1}50%{transform:scale(1.3);opacity:1;filter:brightness(2)}100%{transform:scale(.2);opacity:0}}
@keyframes flasho{50%{filter:brightness(2.2);transform:scale(1.2)}}
@keyframes shake{0%,100%{transform:translate(0)}20%{transform:translate(-7px,3px)}40%{transform:translate(6px,-3px)}60%{transform:translate(-5px,2px)}80%{transform:translate(4px,-2px)}}
@keyframes bump{0%{transform:scale(1.7)}100%{transform:scale(1)}}
@keyframes bob{to{transform:translateX(-50%) translateY(-4px)}}
@keyframes banner{0%{opacity:0;transform:scale(1.6)}20%,70%{opacity:1;transform:scale(1)}100%{opacity:0;transform:scale(.9)}}
@keyframes pulse{to{filter:brightness(1.25)}}
@keyframes atkup{50%{transform:translateY(-12px) scale(1.15);filter:brightness(1.5)}}
@keyframes redf{0%{opacity:0}30%{opacity:1}100%{opacity:0}}
@keyframes flipin{from{opacity:0;transform:rotateY(90deg) scale(.6)}}
@keyframes glow{to{box-shadow:0 0 18px #fff,0 0 4px #ffe27a}}
.s-water{background-image:url(data:image/webp;base64,)}
.s-fire{background-image:url(data:image/webp;base64,)}
.s-wood{background-image:url(data:image/webp;base64,)}
.s-light{background-image:url(data:image/webp;base64,)}
.s-dark{background-image:url(data:image/webp;base64,)}

.spr{display:block;width:100%;height:100%;background-repeat:no-repeat;background-size:600% 400%;background-position:calc(var(--cx)*20%) calc(var(--ry)*33.3333%);filter:drop-shadow(0 2px 3px rgba(0,0,0,.55));pointer-events:none}
.en .face{width:78px;height:78px;margin:0 auto;display:grid;place-items:center}
.en.boss .face{width:140px;height:140px}
.floor .fn{width:54px;height:54px;display:block;overflow:visible;background:radial-gradient(circle at 50% 38%,color-mix(in srgb,var(--c) 40%,#0f1433) 0,#0a0e27 96%)}
.floor .fn .spr{position:absolute;inset:3px;width:calc(100% - 6px);height:calc(100% - 6px)}
.floor .fn b{position:absolute;right:3px;bottom:0;font-size:15px;text-shadow:0 1px 3px #000,0 0 5px #000}
.floor.done .fn::after{top:-5px;right:-5px;bottom:auto}
.emb{display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin-bottom:10px}.emb div{aspect-ratio:1}
.stb{width:58px;height:58px;margin:0 auto 2px}
.orb i{width:96%;height:96%;border-radius:0;box-shadow:none;font-size:0;background:url(data:image/webp;base64,) no-repeat;background-size:600% 100%;background-position:calc(var(--ox)*20%) 0;filter:drop-shadow(0 2px 3px rgba(0,0,0,.6))}
:root{--frames:url(data:image/webp;base64,);--badges:url(data:image/webp;base64,);--stars:url(data:image/webp;base64,);--icons:url(data:image/webp;base64,)}
.ico{display:inline-block;width:1.3em;height:1.3em;vertical-align:-.3em;background:var(--icons) no-repeat;background-size:1200% 100%;background-position:calc(var(--ii)*9.0909%) 0}
.abg{display:block;aspect-ratio:1;background:var(--badges) no-repeat;background-size:600% 100%;background-position:calc(var(--ai)*20%) 0}
.abg.in{display:inline-block;width:1.5em;height:1.5em;vertical-align:-.38em}
.star{display:inline-block;width:1.15em;height:1.15em;vertical-align:-.25em;background:var(--stars) no-repeat;background-size:800% 100%;background-position:calc(var(--si)*14.2857%) 0}
.arrowi{display:inline-block;width:46px;height:46px;background:var(--stars) no-repeat;background-size:800% 100%;background-position:100% 0}
.mc .art{position:absolute;left:7%;right:7%;top:7%;bottom:7%;border-radius:9%;overflow:hidden;display:grid;place-items:center;background:radial-gradient(circle at 50% 38%,color-mix(in srgb,var(--c) 40%,#0f1433) 0,#0a0e27 96%)}
.mc .art .spr{width:100%;height:auto;aspect-ratio:1}
.mc .frm{position:absolute;left:50%;top:50%;width:173.6%;aspect-ratio:400/448;transform:translate(-50%,-50%);background:var(--frames) no-repeat;background-size:700% 100%;background-position:calc(var(--fr)*16.6667%) 0;pointer-events:none}
.mc>.abg{position:absolute;left:-5%;top:-4%;width:29%;filter:drop-shadow(0 1px 2px rgba(0,0,0,.7))}
.mc .lvz{position:absolute;right:13%;bottom:14%;font-size:9px;font-weight:800;text-shadow:0 0 3px #000,0 1px 2px #000}
.mc .stz{position:absolute;left:12%;bottom:13%;display:flex;align-items:center;font-size:9px;font-weight:800;color:#ffe27a;text-shadow:0 0 3px #000,0 1px 2px #000;line-height:1}
.mc .stz .star{width:13px;height:13px;vertical-align:baseline}
.mc i.lk{position:absolute;right:5%;top:6%;width:25%;aspect-ratio:1;--ii:5;background:var(--icons) no-repeat;background-size:1200% 100%;background-position:calc(var(--ii)*9.0909%) 0;filter:drop-shadow(0 1px 2px #000)}
.mc i.nw{position:absolute;left:-8%;bottom:30%;width:54%;aspect-ratio:1;--ii:11;background:var(--icons) no-repeat;background-size:1200% 100%;background-position:calc(var(--ii)*9.0909%) 0;display:grid;place-items:center;font-style:normal;font-size:8px;font-weight:900;color:#fff;text-shadow:0 1px 2px #000}
.mc i.tmk{position:absolute;left:-2%;top:25%;font-style:normal;font-size:9px;font-weight:800;line-height:1;background:#2d8cff;color:#fff;border-radius:4px;padding:2px 3px;border:1px solid #fff9}
.mc i.sk2{position:absolute;right:-2%;top:30%;font-style:normal;font-size:9px;font-weight:800;line-height:1;background:#ffb02e;color:#3a2200;border-radius:4px;padding:2px 3px;border:1px solid #fff9}
