/* ================= team & friends ================= */
function mkMember(d,lv,friend,sl){const st=statsAt(d,lv),as=(!friend&&d.as)?{...d.as,cd:effCd(d.as,sl)}:null;return{d,name:d.name,emo:d.emo,attr:d.attr,rarity:d.rarity,lv,hp:st.hp,atk:st.atk,rcv:st.rcv,ls:d.ls,as,cdLeft:as?Math.ceil(as.cd/2):0,sl:sl||1,friend:!!friend}}
function buildTeam(fr){
  const arr=[];
  S.teams[S.at].forEach((u,i)=>{if(!u)return;const c=byUid(u);if(!c)return;arr.push(mkMember(CARD[c.id],lvOf(c),false,c.sl))});
  if(S.teams[S.at][0]==null)return [];
  if(fr)arr.push(mkMember(CARD[fr.id],fr.lv,true));
  return arr;
}
function applyLeaders(team,leaders){
  const L=leaders.filter(Boolean).map(m=>m.ls).filter(Boolean),info={red:0,time:0,combos:[]};let redP=1;
  team.forEach(m=>{
    let h=1,a=1,r=1;
    L.forEach(o=>{
      if(o.hpAll)h*=o.hpAll;if(o.rcvAll)r*=o.rcvAll;
      if(o.hpA&&o.hpA.a.includes(m.attr))h*=o.hpA.m;
      if(o.atkA&&o.atkA.a.includes(m.attr))a*=o.atkA.m;
    });
    m.hp=Math.round(m.hp*h);m.atk=Math.round(m.atk*a);m.rcv=Math.round(m.rcv*r);
  });
  L.forEach(o=>{if(o.red)redP*=1-o.red;if(o.time)info.time+=o.time;if(o.combo)info.combos.push(o.combo)});
  info.red=1-redP;
  return info;
}
function genFriends(){
  const maxR=clamp(3+Math.floor(S.floor/12),3,6),out=[];
  for(let i=0;i<6;i++){const r=ri(Math.max(3,maxR-2),maxR),d=CARD[pick(POOL[r])];out.push({id:d.id,lv:Math.max(1,Math.round(maxLv(r)*rnd(.4,1))),name:`玩家${ri(1000,9999)}`})}
  return out;
}
